{
  "name": "liuliangzhangben.cc",
  "version": "1.0.0",
  "private": true,
  "description": "流量账本：机场用量记录、倍率计算与套餐核对",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev site",
    "content:plan": "tsx scripts/content-plan.ts",
    "content:prepare": "tsx scripts/content-prepare.ts",
    "check:structure": "tsx scripts/check-structure.ts",
    "check:content": "tsx scripts/check-content.ts",
    "check:links": "tsx scripts/check-links.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:site": "vitepress build site",
    "search:index": "pagefind --site site/.vitepress/dist",
    "build": "npm run check:structure && npm run content:prepare && npm run build:site && npm run search:index && npm run check:links",
    "preview": "vitepress preview site",
    "audit:anti-ai": "tsx scripts/audit-anti-ai-urls.ts",
    "audit:similarity": "tsx scripts/audit-content-similarity.ts",
    "check:all": "npm run typecheck && npm run test && npm run check:structure && npm run check:content && npm run check:secrets && npm run audit:similarity"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "pagefind": "^1.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.8"
  }
}
